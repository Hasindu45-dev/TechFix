<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceColor"
    tools:context="com.techfix.app.customer.TrackRepairActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primaryColor"
            app:title="Track Repair Progress"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/noActiveRepairsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No active repair requests found."
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content Layout (Hidden if empty) -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dropdown to select active ticket -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ticketSelectLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Repair Ticket"
            app:boxStrokeColor="@color/primaryColor"
            app:hintTextColor="@color/primaryColor">

            <AutoCompleteTextView
                android:id="@+id/ticketAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Summary Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dividerColor">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lblDeviceModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device: Loading..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/lblServiceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service: Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/primaryLightColor"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/lblBranchInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned Branch: Loading..."
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/lblTechnicianInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned Technician: Loading..."
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timeline Progress scroll section -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/timelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- Timeline items will be dynamically populated in Java activity -->

            </LinearLayout>
        </ScrollView>

        <!-- Proceed to Payment button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedToPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Proceed to Payment"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/secondaryColor"
            app:cornerRadius="8dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
