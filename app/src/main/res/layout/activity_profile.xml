<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceColor"
    tools:context="com.techfix.app.customer.ProfileActivity">

    <!-- AppBar/Header -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_primary"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/profileTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/profileSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View and update your personal details"
            android:textSize="13sp"
            android:textColor="@color/secondaryLightColor"
            android:layout_below="@id/profileTitleText"
            android:layout_marginTop="2dp" />
    </RelativeLayout>

    <!-- Scrollable Profile Content -->
    <ScrollView
        android:id="@+id/scrollViewProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/customerBottomNavigationCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dividerColor"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- Avatar Initials Circle -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardBackgroundColor="@color/primaryColor"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/secondaryColor"
                        app:cardElevation="0dp"
                        android:layout_marginBottom="16dp">
                        
                        <TextView
                            android:id="@+id/profileInitialsText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="U"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- User Name Label -->
                    <TextView
                        android:id="@+id/lblProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary" />

                    <!-- User Role Label -->
                    <TextView
                        android:id="@+id/lblProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer"
                        android:textSize="12sp"
                        android:textColor="@color/primaryLightColor"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"
                        android:layout_marginVertical="20dp" />

                    <!-- Form Inputs -->
                    <!-- Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        app:boxStrokeColor="@color/primaryColor"
                        app:hintTextColor="@color/primaryColor"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profileNameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="@color/textPrimary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Input (Disabled/Non-editable) -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email Address"
                        app:boxStrokeColor="@color/dividerColor"
                        app:hintTextColor="@color/textSecondary"
                        android:layout_marginBottom="12dp"
                        android:enabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profileEmailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/textSecondary"
                            android:focusable="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Phone Number"
                        app:boxStrokeColor="@color/primaryColor"
                        app:hintTextColor="@color/primaryColor"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profilePhoneEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="@color/textPrimary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Address Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Address"
                        app:boxStrokeColor="@color/primaryColor"
                        app:hintTextColor="@color/primaryColor"
                        android:layout_marginBottom="24dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profileAddressEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:textColor="@color/textPrimary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/profileProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <!-- Save Changes Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save Changes"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryColor"
                        android:background="@drawable/gradient_button"
                        app:backgroundTint="@null"
                        app:cornerRadius="25dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Log Out Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Log Out"
                        android:textSize="15sp"
                        android:textColor="@color/warningColor"
                        app:strokeColor="@color/warningColor"
                        app:cornerRadius="25dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Capsule Bottom Navigation for Customer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/customerBottomNavigationCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/primaryColor"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Home tab -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Track tab -->
            <LinearLayout
                android:id="@+id/navTrack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavTrack"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Book tab (Center Button) -->
            <LinearLayout
                android:id="@+id/navBook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/secondaryColor"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/primaryColor" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- History tab -->
            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavHistory"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Profile tab (Active) -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="@color/secondaryColor" />
                <TextView
                    android:id="@+id/txtNavProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="9sp"
                    android:textColor="@color/secondaryColor" />
            </LinearLayout>
            
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Capsule Bottom Navigation for Admin -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adminBottomNavigationCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/primaryColor"
        app:strokeWidth="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Home tab -->
            <LinearLayout
                android:id="@+id/navAdminHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavAdminHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavAdminHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Technicians tab -->
            <LinearLayout
                android:id="@+id/navAdminTechs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavAdminTechs"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavAdminTechs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Techs"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Services tab -->
            <LinearLayout
                android:id="@+id/navAdminServices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavAdminServices"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavAdminServices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Inventory tab (Spare Parts) -->
            <LinearLayout
                android:id="@+id/navAdminInventory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavAdminInventory"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/primaryLightColor" />
                <TextView
                    android:id="@+id/txtNavAdminInventory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inventory"
                    android:textSize="9sp"
                    android:textColor="@color/primaryLightColor" />
            </LinearLayout>

            <!-- Profile tab (Active) -->
            <LinearLayout
                android:id="@+id/navAdminProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgNavAdminProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="@color/secondaryColor" />
                <TextView
                    android:id="@+id/txtNavAdminProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="9sp"
                    android:textColor="@color/secondaryColor" />
            </LinearLayout>
            
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
