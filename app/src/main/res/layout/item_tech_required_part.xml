<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/dividerColor"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Part Name -->
        <TextView
            android:id="@+id/techPartName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dell Inspiron Battery"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_alignParentStart="true" />

        <!-- Quantity Required vs Available -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/techPartName"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/techPartReqQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required: 1"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/techPartAvailQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available at Branch: 8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primaryColor" />

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
