<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/dividerColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/jobIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TICKET: #12345"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Date: 12/08/2026"
                android:textSize="12sp"
                android:textColor="@color/textSecondary" />
        </RelativeLayout>

        <TextView
            android:id="@+id/jobDeviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dell Latitude 5490"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/jobServiceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service: Laptop Screen Repair"
            android:textSize="14sp"
            android:textColor="@color/primaryLightColor"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/jobCustomerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer: Amal Perera (0771234567)"
            android:textSize="13sp"
            android:textColor="@color/textPrimary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/jobTechnicianText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Technician: Kamal Perera"
            android:textSize="13sp"
            android:textColor="@color/primaryLightColor"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerColor"
            android:layout_marginVertical="12dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Current Status Badge -->
            <TextView
                android:id="@+id/jobStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request Submitted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/primaryColor"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <!-- Update Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateJob"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Update status"
                android:textSize="12sp"
                app:strokeColor="@color/secondaryColor"
                app:strokeWidth="1dp"
                android:textColor="@color/secondaryColor"
                android:paddingHorizontal="12dp"
                app:cornerRadius="6dp" />
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
